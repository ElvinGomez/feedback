PORT=3010
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/feedback-service
CORS_ORIGIN=*
CONFIG_SERVICE_BASE_URL=https://your-config-service.example.com
FEATURE_FLAGS_REFRESH_MS=15000
LOGTO_ENDPOINT=https://your-logto.example.com
LOGTO_RESOURCE=

# Travel mode audience gating (survey/campaign delivery) — required only for
# requests that include countryCode (Travel mode users). Do not reuse the
# mobile EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN (pk.) in production.
MAPBOX_ACCESS_TOKEN=
# GEOCODE_CACHE_TTL_MS=3600000
IP_GEO_PROVIDER=ipinfo
IP_GEO_API_KEY=
# IP_GEO_CACHE_TTL_MS=3600000

FEEDBACK_INTERNAL_API_KEY=change-me
# Legacy alias:
# REPORTS_INTERNAL_API_KEY=change-me

# User-management — suspension checks after Logto auth (skip if unset).
# Must match USERS_INTERNAL_API_KEY on tripsi-user-management / tripsi-admin.
USER_MANAGEMENT_SERVICE_BASE_URL=http://localhost:3050
USERS_INTERNAL_API_KEY=
# USER_SUSPENSION_CACHE_MS=30000

# Spots — visit/note owner checks so users cannot report themselves (skip if unset).
# Must match SPOTS_INTERNAL_API_KEY on spots / tripsi-admin.
SPOTS_SERVICE_BASE_URL=http://localhost:3000
SPOTS_INTERNAL_API_KEY=
