PORT=3010
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/feedback-service
CORS_ORIGIN=*
CONFIG_SERVICE_BASE_URL=https://your-config-service.example.com
FEATURE_FLAGS_REFRESH_MS=15000
LOGTO_ENDPOINT=https://your-logto.example.com
